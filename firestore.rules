rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(fid) {
      return signedIn() && request.auth.uid in get(/databases/$(db)/documents/families/$(fid)).data.memberIds;
    }

    // Each user can read/write only their own profile
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Invite codes -> family id (readable by any signed-in user so they can join)
    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /families/{fid} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.memberIds == [request.auth.uid];
      // members read; non-members may read only to join via code
      allow read: if signedIn();
      // join: add only yourself; leave: remove only yourself; owner can edit name
      allow update: if signedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && (request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()) == [request.auth.uid].toSet()
              || resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet()) == [request.auth.uid].toSet()))
        || resource.data.ownerUid == request.auth.uid);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /members/{uid} {
        allow read: if isMember(fid);
        allow write: if signedIn() && request.auth.uid == uid;
      }
      match /alerts/{aid} {
        allow read: if isMember(fid);
        allow create: if isMember(fid) && request.resource.data.byUid == request.auth.uid
                      && request.resource.data.snippet.size() <= 200;
        allow delete: if isMember(fid) && resource.data.byUid == request.auth.uid;
      }
    }
  }
}
